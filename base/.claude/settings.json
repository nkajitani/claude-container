{
  "permissions": {
    "deny": [
      "Read(./.env)"
    ],
    "additionalDirectories": [
      "/root/.claude/logs"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh /root/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "language": "japanese",
  "alwaysThinkingEnabled": false,
  "minimumVersion": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "dangerouslyDisableSandbox": true,
  "defaultMode": "acceptEdits",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/root/.claude/hooks/log-agent.sh",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/root/.claude/hooks/log-agent.sh",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
